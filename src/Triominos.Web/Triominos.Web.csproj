<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>Triominos.Web</RootNamespace>
    <!-- No ICU data (217 KiB Brotli for a Dutch browser): the game compares names ordinally and the UI text is fixed Dutch, so nothing depends on the culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SceneDir>$(MSBuildProjectDirectory)/scene/</SceneDir>
    <SceneOutput>wwwroot/js/scene/</SceneOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Triominos.Core\Triominos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Triominos.Web.Tests" />
  </ItemGroup>

  <!-- The scene sources are TypeScript built by Vite; keep them and node_modules out of the C# build. -->
  <ItemGroup>
    <Content Remove="scene/**" />
    <None Remove="scene/**" />
    <Content Remove="$(SceneOutput)**" />
  </ItemGroup>

  <!--
    Builds the Three.js scene with Vite before the C# build, then adds the output as web content.
    The output is added inside the target because it does not exist yet when the project is evaluated.
    Set SkipSceneBuild=true to use an existing build (for example while `npm run watch` runs).
  -->
  <Target Name="BuildScene" BeforeTargets="BeforeBuild" DependsOnTargets="InstallSceneDependencies" Condition="'$(SkipSceneBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(SceneDir)" />
  </Target>

  <!--
    Installs the scene's packages when node_modules is missing or older than package-lock.json. npm writes
    node_modules/.package-lock.json at the end of every install, so a changed lock file (a new package after a
    pull) installs again instead of failing the build on a module that is not there.
  -->
  <Target Name="InstallSceneDependencies" Inputs="$(SceneDir)package-lock.json" Outputs="$(SceneDir)node_modules/.package-lock.json" Condition="'$(SkipSceneBuild)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(SceneDir)" />
  </Target>

  <Target Name="IncludeScene" AfterTargets="BuildScene" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Include="$(SceneOutput)**" />
    </ItemGroup>
  </Target>

</Project>
