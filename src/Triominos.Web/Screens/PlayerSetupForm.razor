@using Triominos.Core.Game
@using Triominos.Web.Play

<div class="overlay">
    <div class="panel setup">
        <h2>Nieuw spel</h2>
        <p>Alle mensen zitten achter hetzelfde scherm en spelen om de beurt; de computer speelt zelf. Wie begint, bepalen de stenen.</p>
        @if (ReplacesGame)
        {
            <p class="note">Het spel dat nu bezig is, wordt vervangen.</p>
        }

        @{
            var issue = Issue;
        }

        <div class="setup-players">
            @for (var i = 0; i < _slots.Count; i++)
            {
                var index = i;
                var slot = _slots[i];
                <div class="setup-player @(issue?.Index == index ? "invalid" : null)" style="--player: @PlayerColors.Hex(slot.Color)">
                    <i class="swatch"></i>
                    <input class="name-input" type="text" maxlength="@PlayerSetup.MaxNameLength" autocomplete="off"
                           aria-label="Naam van speler @(index + 1)" @bind="slot.Name" @bind:event="oninput" />
                    <button type="button" class="kind-toggle @(slot.IsComputer ? "computer" : null)"
                            aria-label="Speler @(index + 1) is een @(slot.IsComputer ? "computer" : "mens")" aria-pressed="@(slot.IsComputer ? "true" : "false")"
                            title="@KindTitle(slot)" disabled="@(!slot.IsComputer && HumanCount <= 1)"
                            @onclick="() => ToggleComputer(index)">@(slot.IsComputer ? "Computer" : "Mens")</button>
                    <div class="swatches" role="group" aria-label="Kleur van speler @(index + 1)">
                        @foreach (var color in PlayerColors.All)
                        {
                            var taken = IsTaken(color, index);
                            <button type="button" class="swatch-button @(slot.Color == color ? "selected" : null)"
                                    style="--player: @PlayerColors.Hex(color)" disabled="@taken"
                                    title="@ColorTitle(color, taken)"
                                    aria-label="@PlayerColors.Label(color)" aria-pressed="@(slot.Color == color ? "true" : "false")"
                                    @onclick="() => slot.Color = color"></button>
                        }
                    </div>
                    <button type="button" class="remove" title="Speler verwijderen" aria-label="Speler @(index + 1) verwijderen"
                            disabled="@(_slots.Count <= Scoring.MinPlayers || (!slot.IsComputer && HumanCount <= 1))" @onclick="() => RemovePlayer(index)">✕</button>
                </div>
            }
        </div>

        <button type="button" class="button" disabled="@(_slots.Count >= Scoring.MaxPlayers)" @onclick="AddPlayer">Speler toevoegen</button>

        <p class="problem" role="alert">@ProblemText</p>

        <div class="menu-buttons">
            <button type="button" class="button primary" disabled="@(issue is not null)" @onclick="StartAsync">Start het spel</button>
            <button type="button" class="button" @onclick="OnBack">Terug</button>
        </div>
    </div>
</div>

@code {
    private readonly List<Slot> _slots = [];

    /// <summary>Gets or sets the players the form starts with, for instance those of the last game.</summary>
    [Parameter]
    public IReadOnlyList<PlayerSetup> Players { get; set; } = PlayerSetup.Default;

    /// <summary>Gets or sets whether starting a game throws away a game that is still going.</summary>
    [Parameter]
    public bool ReplacesGame { get; set; }

    /// <summary>Gets or sets what happens when the player starts the game; receives the players in turn order.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<PlayerSetup>> OnStart { get; set; }

    /// <summary>Gets or sets what happens when the player goes back.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private int HumanCount => _slots.Count(s => !s.IsComputer);

    private string KindTitle(Slot slot) =>
        slot.IsComputer ? "De computer speelt deze speler (klik voor een mens)"
        : HumanCount <= 1 ? "Er moet minstens één mens meespelen"
        : "Een mens speelt deze speler (klik voor de computer)";

    private PlayerNameIssue? Issue => PlayerNameCheck.Find([.. _slots.Select(s => s.Name.Trim())]);

    private string? ProblemText => Issue?.Problem switch
    {
        PlayerNameProblem.Blank => "Geef elke speler een naam.",
        PlayerNameProblem.Duplicate => "Elke speler heeft een eigen naam nodig.",
        _ => null,
    };

    protected override void OnInitialized()
    {
        _slots.AddRange(Players.Select(p => new Slot(p.Name, p.Color, p.IsComputer)));
    }

    private bool IsTaken(PlayerColor color, int index) =>
        _slots.Where((_, i) => i != index).Any(s => s.Color == color);

    private static string ColorTitle(PlayerColor color, bool taken) =>
        taken ? $"{PlayerColors.Label(color)} (al in gebruik)" : PlayerColors.Label(color);

    private void AddPlayer()
    {
        if (_slots.Count >= Scoring.MaxPlayers)
        {
            return;
        }

        var color = PlayerColors.All.First(c => _slots.All(s => s.Color != c));
        var number = 1;
        while (_slots.Any(s => string.Equals(s.Name.Trim(), $"Speler {number}", StringComparison.OrdinalIgnoreCase)))
        {
            number++;
        }

        _slots.Add(new Slot($"Speler {number}", color, isComputer: false));
    }

    /// <summary>
    /// Switches a seat between a human and the computer. At least one human must stay. A name that
    /// is still the default of the old kind ("Speler 2", "Computer") follows to the default of the new one.
    /// </summary>
    private void ToggleComputer(int index)
    {
        var slot = _slots[index];
        if (!slot.IsComputer)
        {
            if (HumanCount <= 1)
            {
                return;
            }

            slot.IsComputer = true;
            if (IsDefaultName(slot.Name, "Speler"))
            {
                slot.Name = FreeName(PlayerSetup.ComputerName, index);
            }
        }
        else
        {
            slot.IsComputer = false;
            if (IsDefaultName(slot.Name, PlayerSetup.ComputerName))
            {
                slot.Name = FreeName("Speler", index);
            }
        }
    }

    /// <summary>Whether a name is the prefix alone or the prefix and a number, as the form hands them out.</summary>
    private static bool IsDefaultName(string name, string prefix)
    {
        var trimmed = name.Trim();
        if (!trimmed.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var rest = trimmed[prefix.Length..].Trim();
        return rest.Length == 0 || rest.All(char.IsAsciiDigit);
    }

    /// <summary>The first default name of a kind that no other seat uses: "Computer", "Computer 2", ... or "Speler 1", ...</summary>
    private string FreeName(string prefix, int ignoreIndex)
    {
        for (var number = 1; ; number++)
        {
            var name = number == 1 && prefix == PlayerSetup.ComputerName ? prefix : $"{prefix} {number}";
            var taken = _slots.Where((_, i) => i != ignoreIndex)
                .Any(s => string.Equals(s.Name.Trim(), name, StringComparison.OrdinalIgnoreCase));
            if (!taken)
            {
                return name;
            }
        }
    }

    private void RemovePlayer(int index)
    {
        if (_slots.Count > Scoring.MinPlayers && (_slots[index].IsComputer || HumanCount > 1))
        {
            _slots.RemoveAt(index);
        }
    }

    private async Task StartAsync()
    {
        if (Issue is not null)
        {
            return;
        }

        await OnStart.InvokeAsync([.. _slots.Select(s => new PlayerSetup(s.Name.Trim(), s.Color, s.IsComputer))]);
    }

    private sealed class Slot(string name, PlayerColor color, bool isComputer)
    {
        public string Name { get; set; } = name;

        public PlayerColor Color { get; set; } = color;

        public bool IsComputer { get; set; } = isComputer;
    }
}
