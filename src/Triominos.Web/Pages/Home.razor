@page "/"
@using Triominos.Core.Game
@using Triominos.Web.Interop
@using Triominos.Web.Play
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Triominos</PageTitle>

<canvas class="scene" @ref="_canvas" @oncontextmenu:preventDefault="true"></canvas>
<div class="vignette"></div>
@* Floating scores; the scene fills this element, so it must stay empty here. *@
<div class="floaters"></div>

<header class="panel brand">
    <h1 class="title">Triominos</h1>
</header>

<aside class="panel players">
    @for (var i = 0; i < _hud.Players.Count; i++)
    {
        var player = _hud.Players[i];
        var isCurrent = i == _hud.CurrentPlayer && !_hud.GameOver;
        <div class="player @(isCurrent ? "current" : null)" data-anchor="player-@i">
            <span class="player-name">@player.Name</span>
            <span class="player-score">@player.Score</span>
            <span class="player-tiles">@player.RackCount @(player.RackCount == 1 ? "steen" : "stenen")</span>
        </div>
    }
</aside>

<footer class="panel actions">
    <div class="pool" title="Stenen in de pot" data-anchor="pot">
        <span class="pool-count">@_hud.Pool</span>
        <span class="pool-label">in de pot</span>
    </div>

    <button class="button" @onclick="DrawAsync" disabled="@(_busy || !_session.CanDraw)" title="Trek een steen (-5 punten, hoogstens 3 per beurt)">
        Trekken<kbd>Spatie</kbd>
    </button>
    <button class="button" @onclick="PassAsync" disabled="@(_busy || !_session.CanPass)" title="Passen kan als je niets kunt leggen en niet meer kunt trekken (-10 punten)">
        Passen
    </button>
    <button class="button" @onclick="NewGameAsync" disabled="@_busy">Nieuw spel</button>

    <label class="quality">
        <span>Kwaliteit</span>
        <select @bind="Quality" @bind:after="QualityChangedAsync">
            <option value="@SceneQuality.Low">Laag</option>
            <option value="@SceneQuality.Medium">Middel</option>
            <option value="@SceneQuality.High">Hoog</option>
        </select>
    </label>
</footer>

<div class="panel message" aria-live="polite">@_hud.Message</div>

<p class="hint">Sleep een steen uit je rek · <kbd>R</kbd> of scrollwiel: draaien · <kbd>Esc</kbd>: annuleren · rechtermuisknop: kijken</p>

@* The next screen waits until the scene has finished playing the move. *@
@if (!_busy && _session.Screen == SessionScreen.Handover)
{
    <div class="overlay">
        <div class="panel">
            <h2>@_session.Game.CurrentPlayer.Name</h2>
            <p>@(_session.Game.Phase == GamePhase.Starting ? "mag beginnen." : "is aan de beurt.")</p>
            <p>Geef het scherm door en kijk pas mee als je aan de beurt bent: je stenen blijven verborgen tot je klaar bent.</p>
            <button class="button primary" @ref="_continueButton" @onclick="ContinueAsync">Toon mijn stenen</button>
        </div>
    </div>
}
else if (!_busy && _session.Screen == SessionScreen.Finished)
{
    <div class="overlay">
        <div class="panel">
            <h2>@(_session.Winner is { } winner ? $"{winner.Name} wint!" : "Gelijkspel")</h2>
            <p>@_session.Message</p>
            <div class="results">
                @foreach (var player in _session.Game.Players.OrderByDescending(p => p.Score))
                {
                    <span class="@(player == _session.Winner ? "winner" : null)">@player.Name</span>
                    <span class="score @(player == _session.Winner ? "winner" : null)">@player.Score</span>
                }
            </div>
            <button class="button primary" @onclick="NewGameAsync">Nieuw spel</button>
        </div>
    </div>
}
