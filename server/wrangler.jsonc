{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triominos",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // The published Blazor site (dotnet publish ... -o publish).
    "directory": "../publish/wwwroot",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; every other request is a free static file.
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    // SQLite-backed objects are the ones the free plan allows.
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
